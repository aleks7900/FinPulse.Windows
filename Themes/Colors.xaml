<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- FinPulse Brand Green Colors -->
    <Color x:Key="FinPulsePrimaryColor">#2E7D32</Color>
    <Color x:Key="FinPulseAccentColor">#43A047</Color>
    <Color x:Key="FinPulseLightGreenColor">#E8F5E9</Color>
    <Color x:Key="FinPulseDarkGreenColor">#1B5E20</Color>

    <Color x:Key="FinPulseNegativeColor">#D32F2F</Color>
    <Color x:Key="FinPulseWarningColor">#FFA000</Color>
    <Color x:Key="FinPulseInfoColor">#1976D2</Color>

    <SolidColorBrush x:Key="FinPulsePrimaryBrush" Color="{StaticResource FinPulsePrimaryColor}" />
    <SolidColorBrush x:Key="FinPulseAccentBrush" Color="{StaticResource FinPulseAccentColor}" />
    <SolidColorBrush x:Key="FinPulseLightGreenBrush" Color="{StaticResource FinPulseLightGreenColor}" />
    <SolidColorBrush x:Key="FinPulseDarkGreenBrush" Color="{StaticResource FinPulseDarkGreenColor}" />

    <SolidColorBrush x:Key="FinPulseNegativeBrush" Color="{StaticResource FinPulseNegativeColor}" />
    <SolidColorBrush x:Key="FinPulseWarningBrush" Color="{StaticResource FinPulseWarningColor}" />
    <SolidColorBrush x:Key="FinPulseInfoBrush" Color="{StaticResource FinPulseInfoColor}" />

</ResourceDictionary>
