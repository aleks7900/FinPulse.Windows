<Page
    x:Class="FinPulse.Windows.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FinPulse.Windows.Models"
    xmlns:vm="using:FinPulse.Windows.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Spacing="4">
                <TextBlock Text="Accounts Portfolio" Style="{StaticResource PageHeaderTextBlockStyle}" />
                <TextBlock Text="Manage bank accounts, cards, and liquid funds" Style="{StaticResource PageSubtitleTextBlockStyle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Click="TransferButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8D4;" FontSize="14" />
                        <TextBlock Text="Transfer Funds" />
                    </StackPanel>
                </Button>
                <Button Click="AddAccountButton_Click" Style="{StaticResource FinPulsePrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add Account" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Master / Detail Grid -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Master: Accounts List -->
            <Border Grid.Column="0" Style="{StaticResource FluentCardBorder}" Padding="10">
                <ListView ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Account">
                            <Grid Padding="8,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="38" Height="38" CornerRadius="8"
                                        Background="{x:Bind ColorHex, Converter={StaticResource HexColorToBrushConverter}}">
                                    <FontIcon Glyph="{x:Bind GlyphIcon}" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind TypeDisplayName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{x:Bind FormattedBalance}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Detail: Selected Account Details -->
            <Border Grid.Column="1" Style="{StaticResource FluentCardBorder}">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE8C7;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Select an account to view details" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Account Details Content -->
                    <ScrollViewer Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="20">

                            <!-- Top Banner Card -->
                            <Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAccountName, Mode=OneWay}" FontSize="24" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAccountInstitution, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Click="DeleteAccount_Click">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource FinPulseNegativeBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Balance Metrics Strip -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource StatCardBorder}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="CURRENT BALANCE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedAccountFormattedBalance, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource StatCardBorder}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="TOTAL INFLOW" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedAccountIncomeString, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource FinPulsePrimaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource StatCardBorder}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="TOTAL OUTFLOW" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedAccountExpenseString, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource FinPulseNegativeBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Account Transactions Ledger -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="Account Transaction History" Style="{StaticResource SectionHeaderTextBlockStyle}" />

                                <ListView ItemsSource="{x:Bind ViewModel.SelectedAccountTransactions, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Transaction">
                                            <Grid Padding="4,8" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="32" Height="32" CornerRadius="6"
                                                        Background="{x:Bind CategoryColorHex, Converter={StaticResource HexColorToBrushConverter}}">
                                                    <FontIcon Glyph="&#xE8C7;" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{x:Bind DisplaySubtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{x:Bind FormattedAmount}" FontWeight="Bold" FontSize="14" 
                                                               Foreground="{x:Bind AmountColor, Converter={StaticResource HexColorToBrushConverter}}" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{x:Bind FormattedDate}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
