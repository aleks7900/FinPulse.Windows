<Page
    x:Class="FinPulse.Windows.Views.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FinPulse.Windows.Models"
    xmlns:vm="using:FinPulse.Windows.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="28,24,28,36">

            <!-- Header Row with Period Selector -->
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="Analytics_HeaderTitle" Text="Financial Analytics" Style="{StaticResource PageHeaderTextBlockStyle}" />
                    <TextBlock x:Uid="Analytics_HeaderSubtitle" Text="Spending patterns, category distributions, and multi-period metrics" Style="{StaticResource PageSubtitleTextBlockStyle}" />
                </StackPanel>

                <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" Width="150"
                          SelectedValue="{x:Bind ViewModel.SelectedPeriod, Mode=TwoWay}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem x:Uid="Analytics_Period_7Days" Tag="7 Days" Content="7 Days" />
                    <ComboBoxItem x:Uid="Analytics_Period_30Days" Tag="30 Days" Content="30 Days" IsSelected="True" />
                    <ComboBoxItem x:Uid="Analytics_Period_3Months" Tag="3 Months" Content="3 Months" />
                    <ComboBoxItem x:Uid="Analytics_Period_6Months" Tag="6 Months" Content="6 Months" />
                    <ComboBoxItem x:Uid="Analytics_Period_1Year" Tag="1 Year" Content="1 Year" />
                </ComboBox>
            </Grid>

            <!-- Metrics Strip -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource FluentCardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Analytics_PeriodIncome_Label" Text="PERIOD INCOME" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.PeriodIncomeString, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource FinPulsePrimaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource FluentCardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Analytics_PeriodExpenses_Label" Text="PERIOD EXPENSES" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.PeriodExpenseString, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource FinPulseNegativeBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource FluentCardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Analytics_SavingsRate_Label" Text="SAVINGS RATE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SavingsRate, Mode=OneWay, Converter={StaticResource RatioToPercentStringConverter}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource FinPulseAccentBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource FluentCardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Analytics_DailyBurn_Label" Text="DAILY BURN RATE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.AverageDailyBurnString, Mode=OneWay}" FontSize="24" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Two-Column Analytics Layout -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Spending By Category Breakdown -->
                <Border Grid.Column="0" Style="{StaticResource FluentCardBorder}">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="Analytics_SpendingByCategory_Title" Text="Spending by Category" Style="{StaticResource SectionHeaderTextBlockStyle}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryBreakdown, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategorySpendItem">
                                    <StackPanel Spacing="6" Margin="0,6">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="12" Height="12" CornerRadius="3"
                                                        Background="{x:Bind HexColor, Converter={StaticResource HexColorToBrushConverter}}" />
                                                <TextBlock Text="{x:Bind CategoryName}" FontWeight="SemiBold" FontSize="13" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind FormattedAmount}" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="{x:Bind FormattedPercentage}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Width="45" TextAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Value="{x:Bind Percentage}" Maximum="100" Height="6" CornerRadius="3"
                                                     Foreground="{x:Bind HexColor, Converter={StaticResource HexColorToBrushConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right Column: Monthly Historical Trend -->
                <Border Grid.Column="1" Style="{StaticResource FluentCardBorder}">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="Analytics_MonthlyTrend_Title" Text="Monthly Spending &amp; Income Trend" Style="{StaticResource SectionHeaderTextBlockStyle}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.MonthlyTrends, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MonthlyTrendItem">
                                    <Border Style="{StaticResource StatCardBorder}" Margin="0,4">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{x:Bind PeriodLabel}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <ProgressBar Value="{x:Bind IncomePercent}" Maximum="100" Height="6" CornerRadius="3" Foreground="{StaticResource FinPulsePrimaryBrush}" />
                                                <ProgressBar Value="{x:Bind ExpensePercent}" Maximum="100" Height="6" CornerRadius="3" Foreground="{StaticResource FinPulseNegativeBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{x:Bind FormattedNet}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right" />
                                                <TextBlock x:Uid="Analytics_NetVariance_Label" Text="Net Variance" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
