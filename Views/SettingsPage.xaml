<Page
    x:Class="FinPulse.Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FinPulse.Windows.Models"
    xmlns:vm="using:FinPulse.Windows.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="28,24,28,36" MaxWidth="800" HorizontalAlignment="Left">

            <!-- Page Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource PageHeaderTextBlockStyle}" />
                <TextBlock Text="Preferences, multi-currency defaults, and cloud synchronization" Style="{StaticResource PageSubtitleTextBlockStyle}" />
            </StackPanel>

            <!-- 1. Google Account & Cloud Identity Section -->
            <Border Style="{StaticResource FluentCardBorder}">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Google Account &amp; Cloud Identity" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                            <TextBlock Text="Connect your Google Account to synchronize across Android and Windows via Cloud Firestore"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Authenticated User Profile -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsLoggedIn, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Profile Avatar -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#4285F4" VerticalAlignment="Center">
                                    <TextBlock Text="G" FontWeight="Bold" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentUser.DisplayName, Mode=OneWay}" FontWeight="Bold" FontSize="15" />
                                        <Border Background="{StaticResource FinPulseLightGreenBrush}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="Google Account" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FinPulseDarkGreenBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentUser.Email, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CurrentUser.Uid, Mode=OneWay}" FontSize="10" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.SignOutCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8F8;" FontSize="13" />
                                        <TextBlock Text="Sign Out" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Unauthenticated / Connect Account State -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsNotLoggedIn, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="G" FontWeight="Bold" FontSize="22" Foreground="#4285F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Not Signed In" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Sign in with your Google account to enable real-time cloud sync with Android."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Click="SignInGoogleButton_Click" Style="{StaticResource FinPulsePrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="G" FontWeight="Bold" FontSize="14" Foreground="White" />
                                            <TextBlock Text="Sign in with Google" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="SignInEmailButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE715;" FontSize="13" />
                                            <TextBlock Text="Email" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Appearance Section -->
            <Border Style="{StaticResource FluentCardBorder}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Appearance &amp; Display" Style="{StaticResource SectionHeaderTextBlockStyle}" />

                    <Grid>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Application Theme" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Select your preferred Fluent color theme" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox HorizontalAlignment="Right" Width="140"
                                  SelectedValue="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                                  SelectedValuePath="Content">
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </Grid>

                    <MenuFlyoutSeparator />

                    <Grid>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Privacy Mode" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Hide sensitive monetary balances on dashboard" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.HideBalances, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Currency Section -->
            <Border Style="{StaticResource FluentCardBorder}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Currency &amp; Regional Formatting" Style="{StaticResource SectionHeaderTextBlockStyle}" />

                    <Grid>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Global Base Currency" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Default currency for aggregated balances and new accounts" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox HorizontalAlignment="Right" Width="200"
                                  ItemsSource="{x:Bind ViewModel.AvailableCurrencies, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedCurrency, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:CurrencyMetadata">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind FlagEmoji}" />
                                        <TextBlock Text="{x:Bind Code}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Symbol}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Cloud Sync Section -->
            <Border Style="{StaticResource FluentCardBorder}">
                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="Firebase Cloud Sync" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.SyncNowCommand}" Style="{StaticResource FinPulsePrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                <TextBlock Text="Sync Now" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StatCardBorder}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SyncStatusText, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource FinPulsePrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource StatCardBorder}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="LAST SYNCED" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.LastSyncText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource StatCardBorder}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="PENDING CHANGES" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.PendingChanges, Mode=OneWay}" FontSize="14" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="FinPulse Companion synchronizes with Google Cloud Firestore project 'finpulse-cloud' using two-way Last-Write-Wins conflict resolution."
                               FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>



            <!-- 5. About Section -->
            <Border Style="{StaticResource FluentCardBorder}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource FinPulsePrimaryBrush}">
                            <FontIcon Glyph="&#xE8C7;" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="FinPulse Companion" FontWeight="Bold" FontSize="15" />
                            <TextBlock Text="Version 1.0.0 • Windows 11 Fluent Edition" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Native companion to the FinPulse Android application. Engineered with C#, WinUI 3, Windows App SDK, Mica material, and institutional double-entry financial bookkeeping."
                               FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
