<Page
    x:Class="FinPulse.Windows.Views.GoalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FinPulse.Windows.Models"
    xmlns:vm="using:FinPulse.Windows.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="28,24,28,36">

            <!-- Header -->
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="Goals_HeaderTitle" Text="Financial Savings Goals" Style="{StaticResource PageHeaderTextBlockStyle}" />
                    <TextBlock x:Uid="Goals_HeaderSubtitle" Text="Set milestone targets, calculate monthly contributions, and deposit funds" Style="{StaticResource PageSubtitleTextBlockStyle}" />
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="AddGoalButton_Click" Style="{StaticResource FinPulsePrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="Goals_NewGoalButton" Text="New Goal" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Goals Grid -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Goals, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:FinancialGoal">
                        <Border Style="{StaticResource FluentCardBorder}" Margin="0,6" Padding="18">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Goal Info & Progress -->
                                <StackPanel Grid.Column="0" Spacing="10">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xF580;" Foreground="{StaticResource FinPulsePrimaryBrush}" FontSize="18" />
                                            <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="16" />
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="6,2" CornerRadius="4">
                                                <TextBlock Text="{x:Bind FormattedTargetDate}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock HorizontalAlignment="Right" FontSize="15">
                                            <Run Text="{x:Bind FormattedCurrentAmount}" FontWeight="Bold" Foreground="{StaticResource FinPulsePrimaryBrush}" />
                                            <Run Text=" / " Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{x:Bind FormattedTargetAmount}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </Grid>

                                    <ProgressBar Value="{x:Bind ProgressPercentInt}" Maximum="100" Height="8" CornerRadius="4"
                                                 Foreground="{StaticResource FinPulsePrimaryBrush}" />

                                    <Grid>
                                        <TextBlock Text="{x:Bind ProgressPercentString}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource FinPulsePrimaryBrush}" />
                                        <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{x:Bind FormattedRemainingAmount}" FontWeight="SemiBold" />
                                            <Run x:Uid="Goals_RemainingToTarget" Text=" remaining to target" />
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>

                                <!-- Suggested Contribution Card -->
                                <Border Grid.Column="1" Style="{StaticResource StatCardBorder}" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Uid="Goals_SuggestedContribution_Label" Text="SUGGESTED CONTRIBUTION" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind FormattedSuggestedMonthlyContribution, Mode=OneTime}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource FinPulseAccentBrush}" />
                                        <TextBlock x:Uid="Goals_PerMonth_Label" Text="Per Month to Reach Deadline" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Click="DepositButton_Click" Tag="{x:Bind Id}" Style="{StaticResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C7;" FontSize="12" />
                                            <TextBlock x:Uid="Goals_DepositButton" Text="Deposit" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="DeleteGoal_Click" Tag="{x:Bind Id}" Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource FinPulseNegativeBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
