<Page
    x:Class="FinPulse.Windows.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FinPulse.Windows.Models"
    xmlns:services="using:FinPulse.Windows.Services"
    xmlns:vm="using:FinPulse.Windows.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="28,24,28,36">

            <!-- Header Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock x:Uid="Overview_HeaderTitle" services:Loc.Uid="Overview_HeaderTitle" Text="FinPulse Companion" Style="{StaticResource PageHeaderTextBlockStyle}" />
                        <Border Background="{StaticResource FinPulseLightGreenBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CurrentMonthYear, Mode=OneWay}" 
                                       Foreground="{StaticResource FinPulsePrimaryBrush}" 
                                       FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Uid="Overview_HeaderSubtitle" services:Loc.Uid="Overview_HeaderSubtitle" Text="Real-time financial status synchronized with FinPulse Cloud" Style="{StaticResource PageSubtitleTextBlockStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Click="QuickAddButton_Click" Style="{StaticResource FinPulsePrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock x:Uid="Overview_AddTransactionButton" services:Loc.Uid="Overview_AddTransactionButton" Text="Add Transaction" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.RefreshTooltip, Mode=OneTime}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- KPI Summary Cards Grid -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Total Net Worth Card -->
                <Border Grid.Column="0" Style="{StaticResource FluentCardBorder}">
                    <Grid>
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C7;" Foreground="{StaticResource FinPulsePrimaryBrush}" FontSize="16" />
                                <TextBlock x:Uid="Overview_TotalBalance_Label" services:Loc.Uid="Overview_TotalBalance_Label" Text="TOTAL BALANCE" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="50" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TotalBalance.FormattedString, Mode=OneWay}" 
                                       FontSize="34" FontWeight="Bold" FontFamily="Segoe UI Variable Display" 
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Uid="Overview_TotalBalance_Desc" services:Loc.Uid="Overview_TotalBalance_Desc" Text="Aggregated across active accounts" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Income Card -->
                <Border Grid.Column="1" Style="{StaticResource FluentCardBorder}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" Foreground="{StaticResource FinPulsePrimaryBrush}" FontSize="14" />
                            <TextBlock x:Uid="Overview_Income_Label" services:Loc.Uid="Overview_Income_Label" Text="INCOME" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.MonthlyIncome.FormattedString, Mode=OneWay}" 
                                   FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource FinPulsePrimaryBrush}" />
                        <TextBlock x:Uid="Overview_ThisMonth_Label" services:Loc.Uid="Overview_ThisMonth_Label" Text="This Month" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Expenses Card -->
                <Border Grid.Column="2" Style="{StaticResource FluentCardBorder}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE898;" Foreground="{StaticResource FinPulseNegativeBrush}" FontSize="14" />
                            <TextBlock x:Uid="Overview_Expenses_Label" services:Loc.Uid="Overview_Expenses_Label" Text="EXPENSES" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.MonthlyExpense.FormattedString, Mode=OneWay}" 
                                   FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource FinPulseNegativeBrush}" />
                        <TextBlock x:Uid="Overview_ThisMonth_Label" services:Loc.Uid="Overview_ThisMonth_Label" Text="This Month" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Net Savings Card -->
                <Border Grid.Column="3" Style="{StaticResource FluentCardBorder}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xF580;" Foreground="{StaticResource FinPulseAccentBrush}" FontSize="14" />
                            <TextBlock x:Uid="Overview_NetSavings_Label" services:Loc.Uid="Overview_NetSavings_Label" Text="NET SAVINGS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.NetSavings.FormattedString, Mode=OneWay}" 
                                   FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Uid="Overview_Variance_Label" services:Loc.Uid="Overview_Variance_Label" Text="Variance" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Content Two-Column Layout -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Cash Flow & Recent Transactions -->
                <StackPanel Grid.Column="0" Spacing="24">

                    <!-- Cash Flow Chart Card -->
                    <Border Style="{StaticResource FluentCardBorder}">
                        <StackPanel Spacing="16">
                            <Grid>
                                <TextBlock x:Uid="Overview_CashFlow_Title" services:Loc.Uid="Overview_CashFlow_Title" Text="Cash Flow Comparison" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource FinPulsePrimaryBrush}" />
                                        <TextBlock x:Uid="Overview_CashFlow_Income" services:Loc.Uid="Overview_CashFlow_Income" Text="Income" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource FinPulseNegativeBrush}" />
                                        <TextBlock x:Uid="Overview_CashFlow_Expense" services:Loc.Uid="Overview_CashFlow_Expense" Text="Expense" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Simple Responsive Bar Visualizer -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CashFlowBars, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="32" Height="140" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CashFlowBarItem">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" Height="100">
                                                <!-- Income Bar -->
                                                <Grid VerticalAlignment="Bottom" ToolTipService.ToolTip="{x:Bind FormattedIncome}">
                                                    <Border Width="22" CornerRadius="4,4,0,0" Background="{StaticResource FinPulsePrimaryBrush}"
                                                            Height="{x:Bind IncomeBarHeight, Mode=OneTime}" MaxHeight="90" MinHeight="6" />
                                                </Grid>
                                                <!-- Expense Bar -->
                                                <Grid VerticalAlignment="Bottom" ToolTipService.ToolTip="{x:Bind FormattedExpense}">
                                                    <Border Width="22" CornerRadius="4,4,0,0" Background="{StaticResource FinPulseNegativeBrush}"
                                                            Height="{x:Bind ExpenseBarHeight, Mode=OneTime}" MaxHeight="90" MinHeight="6" />
                                                </Grid>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind MonthName}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Recent Transactions Ledger Card -->
                    <Border Style="{StaticResource FluentCardBorder}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <TextBlock x:Uid="Overview_RecentTransactions_Title" services:Loc.Uid="Overview_RecentTransactions_Title" Text="Recent Transactions" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                                <HyperlinkButton x:Uid="Overview_ViewAll" services:Loc.Uid="Overview_ViewAll" Content="View All" HorizontalAlignment="Right" Click="ViewAllTransactions_Click" />
                            </Grid>

                            <ListView ItemsSource="{x:Bind ViewModel.RecentTransactions, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Transaction">
                                        <Grid Padding="0,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Category Icon Avatar -->
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                    Background="{x:Bind CategoryColorHex, Converter={StaticResource HexColorToBrushConverter}}">
                                                <FontIcon Glyph="&#xE8C7;" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Title & Subtitle -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind DisplaySubtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Amount & Date -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind FormattedAmount}" FontWeight="Bold" FontSize="14" 
                                                           Foreground="{x:Bind AmountColor, Converter={StaticResource HexColorToBrushConverter}}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{x:Bind FormattedDate}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Accounts & Budgets & Upcoming -->
                <StackPanel Grid.Column="1" Spacing="24">

                    <!-- Accounts Card -->
                    <Border Style="{StaticResource FluentCardBorder}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock x:Uid="Overview_Accounts_Title" services:Loc.Uid="Overview_Accounts_Title" Text="Accounts" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                                <HyperlinkButton x:Uid="Overview_ManageAccounts" services:Loc.Uid="Overview_ManageAccounts" Content="Manage" HorizontalAlignment="Right" Click="ManageAccounts_Click" />
                            </Grid>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Account">
                                        <Border Style="{StaticResource StatCardBorder}" Margin="0,4">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="32" Height="32" CornerRadius="6"
                                                        Background="{x:Bind ColorHex, Converter={StaticResource HexColorToBrushConverter}}">
                                                    <FontIcon Glyph="{x:Bind GlyphIcon}" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind TypeDisplayName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{x:Bind FormattedBalance}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Active Budget Progress Card -->
                    <Border Style="{StaticResource FluentCardBorder}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock x:Uid="Overview_Budgets_Title" services:Loc.Uid="Overview_Budgets_Title" Text="Budget Status" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                                <HyperlinkButton x:Uid="Overview_AllBudgets" services:Loc.Uid="Overview_AllBudgets" Content="All Budgets" HorizontalAlignment="Right" Click="ViewBudgets_Click" />
                            </Grid>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveBudgets, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Budget">
                                        <StackPanel Spacing="6" Margin="0,6">
                                            <Grid>
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock HorizontalAlignment="Right" FontSize="12">
                                                    <Run Text="{x:Bind FormattedSpent}" FontWeight="SemiBold" />
                                                    <Run Text=" / " Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <Run Text="{x:Bind FormattedEffectiveLimit}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </TextBlock>
                                            </Grid>
                                            <ProgressBar Value="{x:Bind ConsumedPercentInt}" Maximum="100" Height="8" CornerRadius="4" 
                                                         Foreground="{x:Bind StatusColor, Converter={StaticResource HexColorToBrushConverter}}" />
                                            <Grid>
                                                <TextBlock Text="{x:Bind StatusText}" FontSize="11" Foreground="{x:Bind StatusColor, Converter={StaticResource HexColorToBrushConverter}}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind FormattedRemaining, Mode=OneTime}" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Upcoming Obligations Card -->
                    <Border Style="{StaticResource FluentCardBorder}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock x:Uid="Overview_Upcoming_Title" services:Loc.Uid="Overview_Upcoming_Title" Text="Upcoming Payments" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                                <HyperlinkButton x:Uid="Overview_ViewRecurring" services:Loc.Uid="Overview_ViewRecurring" Content="Recurring" HorizontalAlignment="Right" Click="ViewRecurring_Click" />
                            </Grid>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.UpcomingRecurring, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:RecurringTransaction">
                                        <Grid Padding="0,6" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{x:Bind FormattedNextDue}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind FormattedAmount}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource FinPulseNegativeBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
