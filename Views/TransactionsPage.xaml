<Page
    x:Class="FinPulse.Windows.Views.TransactionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FinPulse.Windows.Models"
    xmlns:vm="using:FinPulse.Windows.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Transactions Ledger" Style="{StaticResource PageHeaderTextBlockStyle}" />
                <TextBlock Text="Comprehensive table view with multi-column filtering and search" Style="{StaticResource PageSubtitleTextBlockStyle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Click="AddTransactionButton_Click" Style="{StaticResource FinPulsePrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add Transaction" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filter & Search Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource FluentCardBorder}" Padding="14,10" Margin="0,0,0,16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search merchant, notes..."
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Type Filter -->
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                          SelectedValue="{x:Bind ViewModel.SelectedTypeFilter, Mode=TwoWay}"
                          SelectedValuePath="Content">
                    <ComboBoxItem Content="All" IsSelected="True" />
                    <ComboBoxItem Content="Expense" />
                    <ComboBoxItem Content="Income" />
                    <ComboBoxItem Content="Transfer" />
                    <ComboBoxItem Content="Refund" />
                </ComboBox>

                <!-- Account Filter -->
                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" PlaceholderText="All Accounts"
                          ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedAccountFilter, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Account">
                            <TextBlock Text="{x:Bind Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Category Filter -->
                <ComboBox Grid.Column="3" HorizontalAlignment="Stretch" PlaceholderText="All Categories"
                          ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedCategoryFilter, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Category">
                            <TextBlock Text="{x:Bind Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Date Range Preset -->
                <ComboBox Grid.Column="4" HorizontalAlignment="Stretch"
                          SelectedValue="{x:Bind ViewModel.SelectedDateFilter, Mode=TwoWay}"
                          SelectedValuePath="Content">
                    <ComboBoxItem Content="All Time" IsSelected="True" />
                    <ComboBoxItem Content="This Month" />
                    <ComboBoxItem Content="Last Month" />
                    <ComboBoxItem Content="This Year" />
                </ComboBox>

                <!-- Reset Filters Button -->
                <Button Grid.Column="5" HorizontalAlignment="Right" Click="ClearFilters_Click" ToolTipService.ToolTip="Reset Filters">
                    <FontIcon Glyph="&#xE777;" FontSize="14" />
                </Button>
            </Grid>
        </Border>

        <!-- Transactions Table View -->
        <Border Grid.Row="2" Style="{StaticResource FluentCardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Table Column Header -->
                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="DATE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="DESCRIPTION / MERCHANT" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="CATEGORY" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="ACCOUNT" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="TYPE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="5" Text="AMOUNT" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="" />
                    </Grid>
                </Border>

                <!-- Table Rows -->
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredTransactions, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedTransaction, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Transaction">
                            <Grid ColumnSpacing="16" Padding="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>

                                <!-- Date -->
                                <TextBlock Grid.Column="0" Text="{x:Bind FormattedDate}" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- Title / Merchant -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Category -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="10" Height="10" CornerRadius="2"
                                            Background="{x:Bind CategoryColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
                                    <TextBlock Text="{x:Bind CategoryName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Account -->
                                <TextBlock Grid.Column="3" Text="{x:Bind SourceAccountName}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <!-- Type Badge -->
                                <Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,2" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind Type}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>

                                <!-- Amount -->
                                <TextBlock Grid.Column="5" Text="{x:Bind FormattedAmount}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{x:Bind AmountColor, Converter={StaticResource HexColorToBrushConverter}}" />

                                <!-- Delete Action -->
                                <Button Grid.Column="6" Click="DeleteRow_Click" Tag="{x:Bind Id}" Background="Transparent" BorderThickness="0" Padding="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{StaticResource FinPulseNegativeBrush}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Table Footer Status Strip -->
                <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Matching Records:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.FilteredTransactions.Count, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="of" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalTransactionsCount, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Net Total:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.FilteredTotalAmountString, Mode=OneWay}" FontSize="13" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Page>
