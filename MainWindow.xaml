<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FinPulse.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FinPulse.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="FinPulse Companion"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Global Keyboard Accelerators -->
    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="QuickAdd_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Search_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="Refresh_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom WinUI TitleBar with FinPulse Branding -->
        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            Title="FinPulse Companion"
            Subtitle="Windows 11 Edition"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/FinPulseIcon.png" />
            </TitleBar.IconSource>

            <TitleBar.Content>
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,140,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="GlobalSyncButton"
                                Command="{x:Bind ViewModel.TriggerGlobalSyncCommand}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.GlobalSyncTooltip, Mode=OneWay}"
                                Height="32" Padding="8,2" CornerRadius="6"
                                Background="Transparent" BorderBrush="Transparent"
                                IsEnabled="{x:Bind ViewModel.CanTriggerSync, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsSyncing, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.SyncProgressVisibility, Mode=OneWay}"
                                              Width="14" Height="14" />
                                <FontIcon Glyph="{x:Bind ViewModel.GlobalSyncIconGlyph, Mode=OneWay}"
                                          Foreground="{x:Bind ViewModel.GlobalSyncIconBrush, Mode=OneWay}"
                                          FontSize="13"
                                          Visibility="{x:Bind ViewModel.SyncIconVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.GlobalSyncStatusLabel, Mode=OneWay}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{x:Bind ViewModel.GlobalSyncLabelBrush, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <TeachingTip x:Name="GlobalSyncTeachingTip"
                                     Target="{x:Bind GlobalSyncButton}"
                                     PreferredPlacement="BottomRight"
                                     IsLightDismissEnabled="True"
                                     IsOpen="{x:Bind ViewModel.IsFeedbackTipOpen, Mode=OneWay}"
                                     Title="{x:Bind ViewModel.FeedbackTipTitle, Mode=OneWay}"
                                     Subtitle="{x:Bind ViewModel.FeedbackTipSubtitle, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <!-- Main Shell NavigationView -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Auto"
            OpenPaneLength="230"
            CompactPaneLength="48"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.PaneHeader>
                <Border Padding="16,12,16,12">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource FinPulsePrimaryBrush}">
                            <FontIcon Glyph="&#xE8C7;" Foreground="White" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Uid="Nav_BrandTitle" Text="FinPulse" FontWeight="Bold" FontSize="16" FontFamily="Segoe UI Variable Display" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_Overview" Content="Overview" Tag="overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Uid="Nav_Accounts" Content="Accounts" Tag="accounts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Uid="Nav_Transactions" Content="Transactions" Tag="transactions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Uid="Nav_Analytics" Content="Analytics" Tag="analytics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Uid="Nav_Budgets" Content="Budgets" Tag="budgets">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE825;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Uid="Nav_Goals" Content="Goals" Tag="goals">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF580;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Uid="Nav_Recurring" Content="Recurring" Tag="recurring">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE777;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Uid="Nav_Categories" Content="Categories" Tag="categories">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
